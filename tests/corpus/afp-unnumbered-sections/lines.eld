  ("2" 0.09729 0.11294 0.3064 0.32258 0.32258 0.01618 nil nil 0.0157 "CMBX12" 0.0181 t nil 0 "CMBX12" t)
  ("Motivation" 0.14419 0.29418 0.3064 0.32258 0.32258 0.01618 nil 0.3970 0.1500 "CMBX12" 0.0181 t nil 0 "CMBX12" t)
  ("We consider the two kinds of modifications, discrete and continuous, that arise in" 0.09729 0.90173 0.3434 0.35696 0.35696 0.01356 0.00578 0.3187 0.0321 "CMR10" 0.0151 nil nil 12 "CMR10" nil)
