  ("2.1" 0.09729 0.13146 0.44177 0.45525 0.45525 0.01348 nil 0.2780 0.0342 "CMBX10" 0.0151 t nil 0 "CMBX10" t)
  ("Discrete and Continuous Modifications" 0.15776 0.61307 0.44177 0.45525 0.45525 0.01348 0.009 0.2907 0.0961 "CMBX10" 0.0151 t nil 3 "CMBX10" t)
  ("Close inspection of incremental applications reveal that two kinds of modification" 0.09729 0.90165 0.47068 0.48423 0.48423 0.01356 0.00533 0.3234 0.0543 "CMR10" 0.0151 nil nil 10 "CMR10" nil)
  ("arise naturally: discrete/dynamic and continuous/kinetic." 0.09729 0.67952 0.48886 0.50241 0.50241 0.01356 0.00752 0.2486 0.0468 "CMR10" 0.0151 nil nil 4 "CMR10" nil)
  ("Discrete/Dynamic: A discrete or dynamic modification is a combinatorial" 0.09729 0.9011 0.52013 0.53369 0.53369 0.01356 0.01161 0.2960 0.2203 "CMR10" 0.0151 nil nil 8 "CMBX10" t)
