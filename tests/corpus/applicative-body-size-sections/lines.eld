  ("Functional pearl" 0.4387 0.5563 0.1388 0.1494 0.1494 0.0105 0.0060 0.2161 0.0772)
  ("3" 0.7904 0.7988 0.1388 0.1494 0.1494 0.0105 nil nil 0.0084)
