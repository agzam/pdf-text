  ("assumed" 0.5674 0.6377 0.4150 0.4284 0.4284 0.0134 nil 0.2905 0.0703)
  ("MP, 1, 2" 0.5674 0.6342 0.4333 0.4467 0.4467 0.0134 0.0033 0.6159 0.0359)
