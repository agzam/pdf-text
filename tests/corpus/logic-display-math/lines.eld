  ("(p | ¬p | ¬q)" 0.2205 0.3224 0.5123 0.5320 0.5320 0.0196 0.0054 0.3618 0.0170)
  ("(q | ¬q | ¬p)" 0.2205 0.3219 0.5306 0.5502 0.5502 0.0196 0.0061 0.3445 0.0159)
  ("(p ∧ q | ¬p | ¬q)" 0.2205 0.3532 0.5488 0.5684 0.5684 0.0196 0.0054 0.3859 0.0170)
  ("(¬¬(p ∧ q) | ¬p | ¬q)" 0.2205 0.3942 0.5671 0.5867 0.5867 0.0196 0.0054 0.3805 0.0505)
