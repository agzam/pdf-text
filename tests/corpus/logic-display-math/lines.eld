  ("axiom" 0.3657 0.4162 0.6928 0.7062 0.7062 0.0134 nil 0.2235 0.0505)
  ("` (A | ¬A | α)" 0.5040 0.6365 0.6889 0.7085 0.7085 0.0196 0.0054 0.4730 0.0119)
  ("cut" 0.3777 0.4043 0.7115 0.7249 0.7249 0.0134 nil 0.1111 0.0266)
  ("(A | α), (¬A | β) ` (α | β)" 0.4423 0.6982 0.7077 0.7273 0.7249 0.0196 0.0054 0.4671 0.0218)
