  ("• The gender of foreign words (Section 1.3.12)" 0.10919 0.50551 0.24428 0.26077 0.26077 0.01648 0.00482 0.3043 0.0117 "UFSJES+Palatino-Roman" 0.0136 nil nil 0 "UFSJES+Palatino-Roman" nil)
