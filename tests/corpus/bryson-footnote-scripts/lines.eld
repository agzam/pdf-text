  ("in upon itself, till it crushes itself down into another singularity, possibly to start the whole" 0.11909 0.8815 0.54483 0.56061 0.56061 0.01578 0.00504 0.2595 0.0157 "KOPLLM+TimesNewRoman" 0.0143 nil nil 0 "KOPLLM+TimesNewRoman" nil)
