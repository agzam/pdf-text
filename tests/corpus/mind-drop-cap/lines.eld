  ("turbocharging successful learning, including counterintuitive test-taking tips" 0.1177 0.8550 0.4756 0.4921 0.4921 0.0165 0.00588 0.2617 0.1376 "AAAAAA+LiberationSerif" 0.0182 nil nil 0)
