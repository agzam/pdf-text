  ("note to the reader" 0.3076 0.6915 0.1581 0.1922 0.1922 0.0341 0.01308 0.2998 0.0944 "AAAAAC+LiberationSans" 0.0364 nil nil 0)
  ("eople who work professionally with math and science often spend years" 0.1729 0.8656 0.2574 0.2739 0.2739 0.0165 0.00588 0.2932 0.0528 "AAAAAA+LiberationSerif" 0.0182 nil nil 0)
  ("discovering effective learning techniques. Once they’ve figured these" 0.1729 0.8410 0.2792 0.2958 0.2958 0.0165 0.00588 0.2613 0.1141 "AAAAAA+LiberationSerif" 0.0182 nil nil 0)
