  ("Exposure and Affect: Overview and Meta-Analysis" 0.2017 0.7977 0.1087 0.1295 0.1295 0.0208 0.0078 0.3439 0.1130)
  ("ofResearch, 1968-1987" 0.3563 0.6423 0.1312 0.1521 0.1521 0.0208 0.0059 0.2436 0.1435)
