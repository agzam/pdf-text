  ("Correspondence concerning this article should be addressed to Rob-" 0.08417 0.48518 0.86171 0.87628 0.87628 0.01457 0.00391 0.2555 0.0935 "Times-Roman" 0.0112 nil nil 0 "Times-Roman" nil)
  ("ert F. Bornstein, Department of Psychology, Gettysburg College, Get-" 0.07042 0.48519 0.87436 0.88893 0.88893 0.01457 0.00391 0.3286 0.0151 "Times-Roman" 0.0111 nil nil 0 "Times-Roman" nil)
