  ("ies for meta-analysis is unwarranted. Results from infrahuman" 0.0696 0.4834 0.0969 0.1132 0.1132 0.0163 0.00421 0.3393 0.0181 "Times-Roman" 0.0123 nil nil 0)
  ("studies are discussed later." 0.0700 0.2408 0.1110 0.1273 0.1273 0.0163 0.00437 0.2492 0.0449 "Times-Roman" 0.0126 nil nil 0)
