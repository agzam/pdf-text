  ("observation is based on a small sample, so we are curious to see how general it truly is" 0.14287 0.85715 0.80336 0.82477 0.82477 0.02141 0.00473 0.3411 0.0984 "ELLVYP+MinionPro-Regular" 0.0159 nil nil 0 "ELLVYP+MinionPro-Regular" nil)
  ("(see Chapter 5!). Ideally, we envision a book that any data scientist would give to his" 0.14286 0.85715 0.82241 0.84382 0.84382 0.02141 0.00473 0.2819 0.0326 "ELLVYP+MinionPro-Regular" 0.0159 nil nil 0 "ELLVYP+MinionPro-Regular" nil)
