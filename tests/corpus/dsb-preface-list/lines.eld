  (18
  ("want to design/implement top-notch data science solutions to business problems, we" 0.14286 0.85714 0.07906 0.10047 0.10047 0.02141 0.00473 0.3239 0.0408 "ELLVYP+MinionPro-Regular" 0.0159 nil nil 0 "ELLVYP+MinionPro-Regular" nil)
