  ("paragraph)" 0.0981 0.1888 0.1915 0.2040 0.2040 0.0125 nil 0.1477 0.0907)
  ("English" 0.2603 0.3313 0.2323 0.2490 0.2490 0.0167 nil 0.2811 0.0710)
  ("John loves Mary." 0.1329 0.2942 0.2588 0.2739 0.2739 0.0151 0.0138 0.2584 0.0408)
  ("studies economy." 0.1000 0.2429 0.2744 0.2895 0.2895 0.0151 0.0052 0.2570 0.0583)
  ("She is pretty. She" 0.3216 0.4919 0.2588 0.2739 0.2739 0.0151 0.0136 0.2781 0.0304)
  ("Her father is a professor. They live in" 0.1329 0.4914 0.2991 0.3142 0.3142 0.0151 0.0115 0.2438 0.0325)
