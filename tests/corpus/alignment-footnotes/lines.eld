  ("Alignment of Paragraphs in Bilingual Texts" 0.4564 0.8233 0.0439 0.0564 0.0564 0.0125 0.0053 0.3204 0.0894)
  ("827" 0.8706 0.9022 0.0439 0.0564 0.0564 0.0125 nil 0.0000 0.0316)
  ("EnglishSpanish" 0.2678 0.7840 0.0870 0.1008 0.1008 0.0138 nil 2.5615 0.5162)
  ("When she saw my baffled look, she corrected" 0.1310 0.5079 0.1133 0.1256 0.1256 0.0123 0.0052 0.3174 0.0477)
  ("herself: \"My grandmother.\"Luego, al percatarse de mi gesto" 0.0981 0.8907 0.1133 0.1413 0.1256 0.0123 0.0052 2.7320 0.0640)
