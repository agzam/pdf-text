  ("She is pretty." 0.2546 0.3928 0.8501 0.8691 0.8691 0.0191 0.0068 0.2517 0.0384)
  ("She studies accounting." 0.1422 0.3929 0.8700 0.8891 0.8891 0.0191 0.0068 0.2316 0.0384)
