  ("Haskell" 0.5288 0.5862 0.4780 0.4898 0.4898 0.0117 nil 0.3012 0.0574)
  ("f x" 0.5288 0.5518 0.4970 0.5087 0.5087 0.0117 0.0089 0.2251 0.0056)
  ("f x y" 0.5288 0.5682 0.5131 0.5248 0.5248 0.0117 0.0089 0.1664 0.0056)
  ("f (g x )" 0.5288 0.5835 0.5292 0.5409 0.5409 0.0117 0.0069 0.3180 0.0056)
  ("f x (g y)" 0.5288 0.5991 0.5453 0.5570 0.5570 0.0117 0.0074 0.1786 0.0056)
