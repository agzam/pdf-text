  ("=" 0.2224 0.2367 0.5692 0.5810 0.5810 0.0117 nil nil 0.0143)
  ("{ applying qsort }" 0.2823 0.4285 0.5660 0.5828 0.5810 0.0117 0.0061 0.2202 0.0092)
